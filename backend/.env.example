# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aicaller

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Telephony — use one
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# OR
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=

# AI
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Voice
# edge-tts is free — no key needed
# faster-whisper runs locally — no key needed

# Public base URL (for webhooks)
PUBLIC_URL=https://yourdomain.com
